DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_aggregator
DIGEST_EMAIL_TO=you@example.com
DIGEST_EMAIL_FROM=jobs@example.com
DIGEST_SMTP_HOST=localhost
DIGEST_SMTP_PORT=1025
DIGEST_SMTP_USERNAME=
DIGEST_SMTP_PASSWORD=
DIGEST_USE_TLS=false
PREFERENCE_KEYWORDS=python,backend,api
PREFERENCE_LOCATION="united states"
PREFERENCE_REMOTE_ONLY=true
INGEST_ENABLE_REAL_SOURCES=false
INGEST_ENABLE_SKELETON_SOURCE=true
INGEST_ENABLE_PLACEHOLDER_SOURCES=false
INGEST_REQUEST_TIMEOUT_SECONDS=20

LOCAL_CONFIG_PATH=config.local.json
